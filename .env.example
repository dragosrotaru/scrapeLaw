# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=
# Optional rotating proxy, e.g. http://user:pass@p.webshare.io:80
PROXY_URL=
# Law Society of Ontario directory search key (visible in the public site's network requests)
LSO_API_KEY=
# Session values copied from a browser session on the respective directory sites
QLD_XSRF_TOKEN=
QLD_SESSION_ID=
LSBC_COOKIE=
